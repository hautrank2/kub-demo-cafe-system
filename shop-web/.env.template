# shop-web — copy file này thành `.env` rồi điền giá trị.
#
#   cp .env.template .env
#   npm install
#   npm run dev
#
# Ba biến dưới đây CHỈ dùng khi chạy `npm run dev`. Chúng được đọc trong
# vite.config.js, không lọt vào bundle gửi xuống trình duyệt — nên đừng đặt
# bí mật gì ở đây.
#
# Trong image production, nginx.conf lo hết việc chuyển /api/* — file .env
# không có tác dụng gì, và .dockerignore cũng loại nó ra khỏi build context.

# Cổng dev server của Vite. Không bắt buộc, mặc định 5210.
DEV_PORT=5210

# Nơi chuyển /api/menu/* tới. Bỏ tiền tố /api rồi mới chuyển đi, nên
# /api/menu/items sẽ thành /menu/items — y hệt nginx.conf làm.
#
# Ba API đều nghe cổng 3000 BÊN TRONG container, nên khi chạy trên máy bạn
# phải map ra ba cổng host khác nhau. Giá trị mặc định dưới đây khớp với
# bảng cổng trong blog.
MENU_API_TARGET=http://localhost:8213

# Nơi chuyển /api/orders* tới.
ORDER_API_TARGET=http://localhost:8214

# shop-web KHÔNG gọi auth-api. Khách đặt đồ uống không cần đăng nhập, nên
# ở đây không có biến nào trỏ tới auth — đó là chủ ý, không phải thiếu sót.
