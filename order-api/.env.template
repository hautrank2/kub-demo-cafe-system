# order-api — copy file này thành `.env` rồi điền giá trị.
#
#   cp .env.template .env
#   npm install
#   npm run dev
#
# `npm run dev` nạp `.env` bằng cờ --env-file của Node (cần Node >= 20.6).
# `npm start` KHÔNG nạp .env — trong container thì biến do Docker hoặc
# Kubernetes đưa vào.

# Chuỗi kết nối MongoDB. BẮT BUỘC.
# PHẢI trỏ vào cùng một database với menu-api: order-api đọc collection
# `items` mà menu-api ghi vào, để lấy tên và giá tại thời điểm đặt.
# Hai service trỏ hai database khác nhau thì POST /orders luôn trả 422
# "Item <id> not found" dù menu hiện đầy món.
MONGODB_URI=mongodb://localhost:27017/cafe

# Địa chỉ auth-api, dạng host:port — KHÔNG kèm http://
# Chỉ dùng cho GET /orders (màn hình pha chế). POST /orders là công khai,
# khách đặt đơn không cần token.
# Chạy trên máy:      localhost:3000
# Chạy trong cụm:     cafe-auth-service:3000
AUTH_ADDRESS=localhost:3000

# order-api luôn nghe cổng 3000 và không đọc biến PORT.
