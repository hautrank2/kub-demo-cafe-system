# auth-api — copy file này thành `.env` rồi điền giá trị.
#
#   cp .env.template .env
#   npm install
#   npm run dev
#
# `npm run dev` nạp `.env` bằng cờ --env-file của Node (cần Node >= 20.6).
# `npm start` KHÔNG nạp .env — nó đọc thẳng process.env, vì trong container thì
# biến do Docker hoặc Kubernetes đưa vào, không có file .env nào cả.
#
# Cả ba biến dưới đây đều BẮT BUỘC. Thiếu TOKEN_KEY thì jwt.sign ném lỗi và
# /auth/login trả 500; thiếu ADMIN_EMAIL hoặc ADMIN_PASSWORD thì không đăng
# nhập được vào đâu cả.

# Chuỗi bí mật dùng để ký JWT. Đổi đi — đừng dùng giá trị mẫu.
# Sinh một chuỗi ngẫu nhiên: openssl rand -base64 32
TOKEN_KEY=

# Tài khoản admin duy nhất của hệ thống. auth-api không có database —
# nó so sánh thẳng với hai biến này.
ADMIN_EMAIL=admin@cafe.local
ADMIN_PASSWORD=

# auth-api luôn nghe cổng 3000 và không đọc biến PORT.
# Muốn đổi cổng thì đổi ở chỗ map cổng (Docker hoặc Service của K8s),
# không phải ở đây.
