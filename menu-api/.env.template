# menu-api — copy file này thành `.env` rồi điền giá trị.
#
#   cp .env.template .env
#   npm install
#   npm run dev
#
# `npm run dev` nạp `.env` bằng cờ --env-file của Node (cần Node >= 20.6).
# `npm start` KHÔNG nạp .env — trong container thì biến do Docker hoặc
# Kubernetes đưa vào.

# Chuỗi kết nối MongoDB. BẮT BUỘC.
# Chạy Mongo bằng Docker trên máy:  docker run -d -p 27017:27017 mongo:6
#   → mongodb://localhost:27017/cafe
# Chạy trong cụm, trỏ vào Service tên cafe-mongo-service:
#   → mongodb://cafe-mongo-service:27017/cafe
# Thiếu biến này thì mongoose.connect ném lỗi ngay khi khởi động — log in ra
# "KHÔNG NỐI ĐƯỢC MONGODB", và mọi endpoint đọc/ghi trả 500.
MONGODB_URI=mongodb://localhost:27017/cafe

# Địa chỉ auth-api, dạng host:port — KHÔNG kèm http://
# menu-api tự ghép thành http://<AUTH_ADDRESS>/auth/verify/<token>
# Chạy trên máy:      localhost:3000  (hoặc cổng bạn map cho auth-api)
# Chạy trong cụm:     cafe-auth-service:3000
# Thiếu hoặc sai biến này thì POST /menu/items trả 503 — không phải 401.
AUTH_ADDRESS=localhost:3000

# Thư mục lưu ảnh món. KHÔNG bắt buộc — mặc định /app/data/images.
# Đây là chỗ volume được mount vào. Giá trị này PHẢI trùng mountPath trong
# Deployment; lệch nhau thì ảnh ghi vào một nơi và đọc từ một nơi khác, và
# không có gì kiểm giúp bạn.
# Chạy trên máy thì trỏ vào một thư mục có quyền ghi, ví dụ ./data/images
MENU_IMAGE_FOLDER=./data/images

# menu-api luôn nghe cổng 3000 và không đọc biến PORT.
